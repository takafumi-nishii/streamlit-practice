{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"]},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u306f\u3058\u3081\u306b","text":"<p>High and Low\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u307e\u3059\uff01</p>"},{"location":"#_2","title":"\u7d42\u308f\u308a\u306b","text":"<p>High and Low\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u307e\u3057\u305f\uff01</p>"},{"location":"about/","title":"About","text":""},{"location":"about/#_1","title":"\u30b2\u30fc\u30e0\u306e\u8aac\u660e","text":"<p>\ud83c\udccf \u57fa\u672c\u7684\u306a\u6d41\u308c</p> <p>\u6e96\u5099</p> <p>52\u679a\u306e\u30c8\u30e9\u30f3\u30d7\u3092\u30b7\u30e3\u30c3\u30d5\u30eb\u3002</p> <p>\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30ab\u30fc\u30c9\u306f\u914d\u3089\u305a\u3001\u5c71\u672d\u30921\u3064\u7528\u610f\u3002</p> <p>\u6700\u521d\u306e\u30ab\u30fc\u30c9\u3092\u30aa\u30fc\u30d7\u30f3</p> <p>\u5c71\u672d\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u3081\u304f\u3063\u3066\u5834\u306b\u51fa\u3059\u3002</p> <p>\u4e88\u60f3</p> <p>\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u6b21\u306b\u3081\u304f\u308b\u30ab\u30fc\u30c9\u306f High \u304b Low \u304b\u300d\u3092\u5ba3\u8a00\u3002</p> <p>\u6b21\u306e\u30ab\u30fc\u30c9\u3092\u3081\u304f\u308b</p> <p>\u5c71\u672d\u304b\u3089\u3082\u30461\u679a\u3081\u304f\u308b\u3002</p> <p>\u4e88\u60f3\u304c\u5f53\u305f\u3063\u3066\u3044\u308c\u3070\u7d99\u7d9a\u3001\u5916\u308c\u308c\u3070\u8ca0\u3051\uff08\u7d42\u4e86 or \u4ea4\u4ee3\uff09\u3002</p> <p>\u7d9a\u884c or \u7d42\u4e86</p> <p>\u6b63\u89e3\u304c\u7d9a\u3051\u3070\u9023\u52dd\u6570\u304c\u4f38\u3073\u308b\u3002</p> <p>\u4f55\u9023\u52dd\u3067\u304d\u308b\u304b\u3092\u7af6\u3046\u306e\u304c\u4e00\u822c\u7684\u3002</p> <p>\ud83d\udca1 \u5224\u5b9a\u306e\u30dd\u30a4\u30f3\u30c8</p> <p>\u30ab\u30fc\u30c9\u306e\u5f37\u3055\u306e\u9806\u756a\u306f\u901a\u5e38\u300c2 \u304c\u6700\u5c0f\u3001A \u304c\u6700\u5927\u300d\u3060\u3051\u3069\u3001\u30eb\u30fc\u30eb\u306b\u3088\u3063\u3066\u300cA \u306f\u6700\u5c0f\u300d\u300cA \u306f\u4e21\u65b9\u3067\u4f7f\u3048\u308b\u300d\u306a\u3069\u306e\u5909\u5f62\u3082\u3042\u308a\u3002</p> <p>\u540c\u3058\u6570\u5b57\u304c\u51fa\u305f\u5834\u5408\u306f\u300c\u5f15\u304d\u5206\u3051\u300d\u304b\u300c\u5916\u308c\u300d\u3068\u3059\u308b\u304b\u306f\u4e8b\u524d\u306b\u6c7a\u3081\u308b\u3002</p> <p>\ud83d\udd04 \u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3</p> <p>\u8907\u6570\u4eba\u30d7\u30ec\u30a4 \u9806\u756a\u306b\u4e88\u60f3\u3057\u3066\u3044\u304d\u3001\u5916\u308c\u305f\u4eba\u304c\u8131\u843d\u3002\u6700\u5f8c\u307e\u3067\u6b8b\u3063\u305f\u4eba\u304c\u52dd\u3061\u3002</p> <p>\u5f97\u70b9\u5236 \u9023\u52dd\u6570\u306b\u5fdc\u3058\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u52a0\u7b97\u3002\u6c7a\u3081\u3089\u308c\u305f\u30e9\u30a6\u30f3\u30c9\u306e\u5408\u8a08\u70b9\u3067\u52dd\u8ca0\u3002</p> <p>\u30ae\u30e3\u30f3\u30d6\u30eb\u98a8 \u5f53\u305f\u308a\u5916\u308c\u306b\u5fdc\u3058\u3066\u30b3\u30a4\u30f3\u3084\u30c1\u30c3\u30d7\u3092\u8ced\u3051\u308b\u3002</p> <p>\u2705 \u307e\u3068\u3081</p> <p>High and Low \u306f</p> <p>\u30eb\u30fc\u30eb\u304c\u30b7\u30f3\u30d7\u30eb</p> <p>1\u4eba\u3067\u3082\u8907\u6570\u4eba\u3067\u3082\u904a\u3079\u308b</p> <p>\u904b\u8981\u7d20\u304c\u5f37\u3044\u3051\u3069\u3001\u9023\u52dd\u3059\u308c\u3070\u76db\u308a\u4e0a\u304c\u308b</p> <p>\u3068\u3044\u3046\u306e\u304c\u9b45\u529b\u306e\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u3067\u3059\u3002</p>"}]}